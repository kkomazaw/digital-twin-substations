apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-dashboard-demo-narrative
  namespace: it-zone
data:
  demo-narrative.json: |
    {
      "annotations": {
        "list": [
          {
            "builtIn": 1,
            "datasource": {
              "type": "grafana",
              "uid": "-- Grafana --"
            },
            "enable": true,
            "hide": true,
            "iconColor": "rgba(0, 211, 255, 1)",
            "name": "Annotations & Alerts",
            "type": "dashboard"
          }
        ]
      },
      "editable": true,
      "fiscalYearStartMonth": 0,
      "graphTooltip": 1,
      "id": null,
      "links": [],
      "liveNow": true,
      "panels": [
        {
          "datasource": null,
          "gridPos": {
            "h": 3,
            "w": 24,
            "x": 0,
            "y": 0
          },
          "id": 100,
          "options": {
            "code": {
              "language": "plaintext",
              "showLineNumbers": false,
              "showMiniMap": false
            },
            "content": "# 次世代デジタル変電所 — 高度分析業務のナラティブ\n\nこのダッシュボードは、ある一日の系統運用員の実際の業務フローを5つのシーンで表現しています。各セクションは時系列に沿って配置されており、PowSyBlによる高度分析が系統運用をどのように変革するかを示します。",
            "mode": "markdown"
          },
          "pluginVersion": "10.2.0",
          "title": "デモナラティブ概要",
          "type": "text"
        },
        {
          "datasource": null,
          "gridPos": {
            "h": 2,
            "w": 24,
            "x": 0,
            "y": 3
          },
          "id": 101,
          "options": {
            "code": {
              "language": "plaintext",
              "showLineNumbers": false,
              "showMiniMap": false
            },
            "content": "## シーン1: 朝、系統を「読む」時間 (06:00)\n\n夜間に自動実行されたLoad Flowの結果がすでに画面に展開されている。84ノードの電圧プロファイルはすべて緑——これは「異常なし」ではなく、「今日の出発点」を意味する。",
            "mode": "markdown"
          },
          "pluginVersion": "10.2.0",
          "title": "シーン1ヘッダー",
          "type": "text"
        },
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "powsybl-api"
          },
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "mappings": [
                {
                  "options": {
                    "CONVERGED": {
                      "color": "green",
                      "index": 0,
                      "text": "収束"
                    },
                    "PARTIALLY_CONVERGED": {
                      "color": "yellow",
                      "index": 1,
                      "text": "部分収束"
                    },
                    "FAILED": {
                      "color": "red",
                      "index": 2,
                      "text": "失敗"
                    }
                  },
                  "type": "value"
                }
              ],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            }
          },
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 0,
            "y": 5
          },
          "id": 1,
          "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "values": false,
              "calcs": [
                "lastNotNull"
              ],
              "fields": "/^convergence_status$/"
            },
            "textMode": "value_and_name"
          },
          "pluginVersion": "10.2.0",
          "targets": [
            {
              "columns": [],
              "datasource": {
                "type": "yesoreyeram-infinity-datasource",
                "uid": "powsybl-api"
              },
              "filters": [],
              "format": "table",
              "global_query_id": "",
              "refId": "A",
              "root_selector": "",
              "source": "url",
              "type": "json",
              "url": "http://10.217.5.224:8000/api/v1/loadflow",
              "url_options": {
                "data": "{\"network_id\":\"ieee14\"}",
                "method": "POST",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ]
              }
            }
          ],
          "title": "潮流計算 収束状態",
          "type": "stat"
        },
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "powsybl-api"
          },
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 5
                  },
                  {
                    "color": "red",
                    "value": 10
                  }
                ]
              },
              "unit": "none"
            }
          },
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 4,
            "y": 5
          },
          "id": 2,
          "options": {
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "values": false,
              "calcs": [
                "lastNotNull"
              ],
              "fields": "/^iterations$/"
            },
            "textMode": "value_and_name"
          },
          "pluginVersion": "10.2.0",
          "targets": [
            {
              "columns": [],
              "datasource": {
                "type": "yesoreyeram-infinity-datasource",
                "uid": "powsybl-api"
              },
              "filters": [],
              "format": "table",
              "global_query_id": "",
              "refId": "A",
              "root_selector": "",
              "source": "url",
              "type": "json",
              "url": "http://10.217.5.224:8000/api/v1/loadflow",
              "url_options": {
                "data": "{\"network_id\":\"ieee14\"}",
                "method": "POST",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ]
              }
            }
          ],
          "title": "計算イテレーション数",
          "type": "stat"
        },
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "powsybl-api"
          },
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              },
              "unit": "ms"
            }
          },
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 8,
            "y": 5
          },
          "id": 3,
          "options": {
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "values": false,
              "calcs": [
                "lastNotNull"
              ],
              "fields": "/^computation_time_ms$/"
            },
